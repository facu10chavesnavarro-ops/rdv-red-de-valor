# Copiá este archivo a contracts/.env y completalo. NUNCA subas .env a git.

# RPC de BSC Testnet (público o de un proveedor como Ankr/QuickNode)
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Token de pago. Vacío = se despliega MockUSDT (18 decimales, con faucet()).
USDT_ADDRESS=

# Chainlink VRF v2.5 — creá y fondeá la suscripción en https://vrf.chain.link (BNB Chain Testnet)
VRF_SUBSCRIPTION_ID=
# Opcionales (por defecto: valores oficiales de BSC Testnet, pago en tBNB nativo)
# VRF_COORDINATOR=0xDA3b641D438362C440Ac5458c57e00a712b66700
# VRF_KEY_HASH=0x8596b430971ac45bdf6088665b9ad8e8630c9d5049ab54b14dff711bee7c0e26
# VRF_NATIVE_PAYMENT=true
# VRF_CALLBACK_GAS_LIMIT=500000
# VRF_CONFIRMATIONS=3

# Parámetros de la rifa
GOAL_USDT=10
DURATION_SECONDS=604800
MAX_NUMBERS=5000
MAX_PER_WALLET=200
# Dirección que recibe los fondos si la rifa tiene éxito (vacío = la wallet que despliega)
TREASURY=
