# Copiá a web/.env.local (o cargalas en Vercel). `npm run env:testnet` completa las 5 primeras.
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
NEXT_PUBLIC_RAFFLE_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_EXPLORER_URL=https://testnet.bscscan.com
NEXT_PUBLIC_LOGS_CHUNK=50000

# Opcional: habilita MetaMask / Trust / WalletConnect en celulares (https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contenido
NEXT_PUBLIC_PRIZE_NAME=iPhone
NEXT_PUBLIC_PRIZE_IMAGE=
NEXT_PUBLIC_AUTHORIZATION_NUMBER=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
